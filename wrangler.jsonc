{
  // Cloudflare deploy settings for rtk.willbarnaby.com
  "name": "reservoir-toolkit",
  "compatibility_date": "2026-11-06",

  // the static site that web/build.py writes
  "assets": {
    "directory": "./dist"
  },

  // serve the Worker at this address; Cloudflare creates DNS and HTTPS
  "routes": [
    { "pattern": "rtk.willbarnaby.com", "custom_domain": true }
  ]
}